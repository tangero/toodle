{
	"name": "skola-ai",
	"workers_dev": true,
	"compatibility_date": "2026-04-15",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},

	// D1 Database
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "skola-ai-db",
			"database_id": "105afe9e-205d-41a2-92b2-1b24ac7f926d"
		}
	],

	// R2 Storage (certificates, lesson images)
	"r2_buckets": [
		{
			"binding": "BUCKET",
			"bucket_name": "skola-ai-storage"
		}
	],

	// Environment variables
	"vars": {
		"APP_URL": "https://skola.aivefirmach.cz",
		"MAIL_FROM": "Letní škola AI <patrick@skola.aivefirmach.cz>",
		"ADMIN_EMAIL": "patrick@zandl.cz"
	}

	// Secrets (configure via `wrangler secret put`):
	// RESEND_API_KEY
	// OPENROUTER_API_KEY
	// OPENROUTER_MODEL (optional, defaults to openrouter/auto)
	// FIO_API_TOKEN
	// JWT_SECRET
	// CRON_SECRET
}
