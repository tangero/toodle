{
  "name": "skola-ai",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "generate-types": "wrangler types",
    "check": "astro check",
    "dev:wrangler": "astro build && wrangler dev --config dist/server/wrangler.json --port 8788 --env-file .dev.vars --persist-to .wrangler/state",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply skola-ai-db --local --persist-to .wrangler/state"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^13.1.9",
    "@astrojs/react": "^5.0.3",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@tailwindcss/vite": "^4.2.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "astro": "^6.1.6",
    "marked": "^18.0.0",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "tailwindcss": "^4.2.2",
    "ulid": "^3.0.2",
    "wrangler": "^4.83.0"
  },
  "overrides": {
    "vite": "^7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@cloudflare/workers-types": "^4.20260531.1",
    "@types/qrcode": "^1.5.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
