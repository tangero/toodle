# ============================================================
# Letní škola AI - Environment Variables (toodle)
# ============================================================
# 
# 1. Zkopíruj tento soubor jako .env.local (pro lokální vývoj)
# 2. Pro produkci nastav secrets přes:
#    wrangler secret put NAZEV
#
# POZOR: Nikdy necommituj skutečné hodnoty!

# --- Základní aplikace ---
APP_URL=http://localhost:8788
MAIL_FROM=Letní škola AI <noreply@tvujdomena.cz>

# --- Povinné Secrets (pro lokální vývoj vyplň reálnými klíči) ---
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
RESEND_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx   # z Resend dashboardu
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxx
# Volitelné: výchozí openrouter/auto dynamicky vybere vhodný model.
OPENROUTER_MODEL=openrouter/auto
FIO_API_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxx                 # z FIO banky (IB API)
JWT_SECRET=change-me-to-a-long-random-string-min-32-chars
CRON_SECRET=change-me-to-another-long-random-string

# --- Admin (pouze tento email má přístup do /admin) ---
ADMIN_EMAIL=tvuj@email.cz

# --- Volitelné: BetterStack monitoring (heartbeaty) ---
# BETTERSTACK_HEARTBEAT_LESSONS=https://uptime.betterstack.com/...
# BETTERSTACK_HEARTBEAT_PAYMENTS=...
# BETTERSTACK_HEARTBEAT_REMINDERS=...
# BETTERSTACK_HEARTBEAT_DIGEST=...

# ============================================================
# Pro Cloudflare lokální emulaci (D1 + R2) používej:
#   npm run dev:wrangler
#
# Viz LOCAL_DEVELOPMENT.md pro kompletní instrukce.
# ============================================================
