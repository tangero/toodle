---
import SiteLayout from '@layouts/SiteLayout.astro';
import { getAll, getOne } from '@lib/db';
import type { Course } from '@lib/types';
import { env } from '@lib/env';
import { loadEventTips } from '@lib/events';
import { deliveryLabel, lessonCountLabel } from '@lib/labels';

const [courses, events] = await Promise.all([
  getAll<Course>(
    env.DB,
    `SELECT * FROM courses WHERE status = 'published' ORDER BY sort_order ASC, created_at ASC`,
  ),
  loadEventTips(2),
]);

// První kurz v katalogu je doporučený pro začátečníky, druhý pro ty, kdo už AI používají.
const [first, second] = courses;

// Ukázku odkazujeme jen tehdy, když má první kurz napsanou první lekci.
const sample = first
  ? await getOne<{ id: string }>(
      env.DB,
      `SELECT id FROM lessons WHERE course_id = ? AND position = 1 AND trim(content_md) != ''`,
      first.id,
    )
  : null;
---

<SiteLayout
  title="E-mailové kurzy ChatGPT a Claude"
  description="Praktické e-mailové kurzy ChatGPT a Claude pro lidi, kteří nejsou programátoři. Jedna krátká lekce každý pracovní den, zdarma."
>
  <section class="wrap hero">
    <p class="mono">E-mailové kurzy ChatGPT a Claude</p>
    <h1>Naučte se pracovat s AI. Jedna krátká lekce denně.</h1>
    <p class="lead">
      Praktické kurzy pro lidi, kteří nejsou programátoři. Každý pracovní den vám přijde jedna lekce
      s úkolem, který si hned vyzkoušíte.
    </p>
    {first && (
      <div class="cta">
        <a class="btn btn-accent" href={`/objednavka/${first.slug}`}>Začít kurzem {first.title}</a>
        {second && (
          <a class="alt" href={`/kurz/${second.slug}`}>Už AI používáte? Pokračujte kurzem {second.title}</a>
        )}
      </div>
    )}
    <dl class="facts">
      <div><dt>Cena</dt><dd>Všechny kurzy zdarma</dd></div>
      <div><dt>Forma</dt><dd>Lekce přímo do e-mailu</dd></div>
      <div><dt>Od roku 2025</dt><dd>Kolem 10 000 lidí</dd></div>
    </dl>
  </section>

  <section class="wrap sec" id="kurzy">
    <h2>Kurzy</h2>
    {courses.length === 0 ? (
      <p class="note">Kurzy právě připravujeme.</p>
    ) : (
      <div class="courses">
        {courses.map((course) => (
          <article class="course">
            <h3><a href={`/kurz/${course.slug}`}>{course.title}</a></h3>
            <p class="col"><span class="mono">Pro koho</span>{course.audience || course.perex}</p>
            {course.requirements && (
              <p class="col"><span class="mono">Co potřebujete</span>{course.requirements}</p>
            )}
            <p class="col narrow">
              <span class="mono">{lessonCountLabel(course.lesson_count)} · {deliveryLabel(course.delivery_mode)}</span>
              <a class="more" href={`/kurz/${course.slug}`}>Zobrazit kurz<span class="sr-only"> {course.title}</span></a>
            </p>
          </article>
        ))}
      </div>
    )}
  </section>

  <section class="wrap sec">
    <div class="split">
      <div class="side">
        <h2>Takhle vypadá lekce</h2>
        <p class="muted">
          Krátký výklad, jedno zadání ke zkopírování a kontrola výsledku. Úryvek je z kurzu
          Bezpečně s AI v práci a ve škole.
        </p>
        {first && sample && (
          <p><a class="more" href={`/kurz/${first.slug}/ukazka`}>Přečíst celou ukázkovou lekci kurzu {first.title}</a></p>
        )}
      </div>
      <div class="main box">
        <p class="box-head">Lekce 6 z 6 · 6 minut čtení</p>
        <div class="box-body">
          <h3>Nechte si pravidla oponovat</h3>
          <p>Teď to nejužitečnější. Pošlete navazující zadání:</p>
          <p class="prompt">
            „Přečti ta pravidla jako člověk, který je chce obejít nebo který je špatně pochopí. Napiš mi:
            1) tři situace z běžné práce, které pravidla neřeší; 2) dvě pravidla, která jsou tak obecná,
            že se nedají zkontrolovat; 3) jedno pravidlo, které je zbytečně přísné a bude se porušovat.
            Pravidla zatím neupravuj.“
          </p>
          <p>
            Projděte odpověď a rozhodněte sami, co z toho je pravda. AI neví, jak vaše práce vypadá,
            a některé námitky budou mimo.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="wrap sec" id="autor">
    <h2>Kurzy píše Patrick Zandl</h2>
    <div class="split">
      <figure class="portrait small">
        <img
          src="/img/patrick-zandl-450.jpg"
          srcset="/img/patrick-zandl-450.jpg 375w, /img/patrick-zandl.jpg 750w"
          sizes="11rem"
          width="375"
          height="450"
          alt="Patrick Zandl"
          loading="lazy"
          decoding="async"
        />
      </figure>
      <div class="main stack">
        <p class="measure">
          Internetový podnikatel, novinář a spisovatel. V roce 1997 spoluzaložil Mobil.cz, v roce 2006
          Stream.cz a v letech 2008 až 2012 vedl Lupa.cz. Napsal osm knih, mimo jiné Mýty a naděje
          digitálního světa.
        </p>
        <p class="measure">
          Dnes se věnuje hlavně využití AI ve firemní praxi: radí firmám a vede workshopy pod značkami
          AI ve firmách a Vibecoding.cz. Škola AI nabízí stejnou zkušenost zdarma každému, kdo se chce
          AI naučit používat.
        </p>
        <p><a class="more" href="/o-autorovi">Více o autorovi</a></p>
        <ul class="links">
          <li><a href="https://cs.wikipedia.org/wiki/Patrick_Zandl">Wikipedie</a></li>
          <li><a href="https://www.linkedin.com/in/patrickzandl">LinkedIn</a></li>
          <li><a href="https://www.aivefirmach.cz/">AI ve firmách</a></li>
          <li><a href="https://www.vibecoding.cz/">Vibecoding.cz</a></li>
        </ul>
      </div>
    </div>
  </section>

  {events.length > 0 && (
    <section class="wrap sec">
      <h2>Další naše AI vzdělávání</h2>
      <div class="cards">
        {events.map((event) => (
          <a class="card" href={event.url}>
            <span class="mono">{[event.label, event.meta].filter(Boolean).join(' · ')}</span>
            <span class="t">{event.title}</span>
            <span class="more">Podrobnosti na Vibecoding.cz</span>
          </a>
        ))}
      </div>
    </section>
  )}

  <section class="wrap sec">
    <div class="band">
      <div class="txt">
        <h2>Nechcete se teď zapisovat do kurzu?</h2>
        <p class="muted measure">
          Patrickův Newsletter píše o AI a technologiích srozumitelně a bez zbytečných podrobností.
          Pro technicky zaměřené čtenáře je tu kanál na WhatsAppu.
        </p>
      </div>
      <div class="act">
        <a class="btn" href="https://zandl.substack.com/?utm_source=skola-ai&utm_medium=web">Odebírat Patrickův Newsletter</a>
        <a class="back" href="https://whatsapp.com/channel/0029VbDhkLcAjPXIv8c3E72Z">Technické AI novinky na WhatsAppu</a>
      </div>
    </div>
  </section>
</SiteLayout>
