---
import PublicLayout from '@layouts/PublicLayout.astro';
import { getAll } from '@lib/db';
import type { Course } from '@lib/types';
import { env } from '@lib/env';

const courses = await getAll<Course>(
  env.DB,
  `SELECT * FROM courses WHERE status = 'published' ORDER BY created_at DESC`,
);

const steps = [
  {
    n: '1',
    title: 'Ráno vám přijde lekce',
    body: 'Stručná, praktická a napsaná lidsky. Bez čekání na čas, kdy si pustíte dlouhé školení.',
  },
  {
    n: '2',
    title: 'Zkopírujete připravený prompt',
    body: 'Nemusíte vymýšlet, jak se AI zeptat. Ukážeme vám konkrétní zadání a vysvětlíme každý nový pojem.',
  },
  {
    n: '3',
    title: 'Použijete výsledek v praxi',
    body: 'E-mail, shrnutí, plán nebo nápad. Každá lekce má jasný výstup, který si rovnou vyzkoušíte.',
  },
];

const testimonials = [
  {
    quote: 'Konečně něco, co jsem dotáhla do konce. Patnáct minut denně zvládnu i ve vlaku.',
    name: 'Jana K.',
    role: 'účetní',
    color: '#2563eb',
  },
  {
    quote: 'Myslel jsem, že na to nemám hlavu. Po týdnu jsem psal e-maily s AI rychleji než kolegové.',
    name: 'Martin V.',
    role: 'obchodní zástupce',
    color: '#f59e0b',
  },
  {
    quote: 'Dobré tempo. Žádná omáčka, hned víte, co máte zkusit. A funguje to.',
    name: 'Petra S.',
    role: 'majitelka kavárny',
    color: '#10b981',
  },
];

const deliveryLabel = (mode: string) => mode === 'next_workday' ? 'Automaticky Po-Pá' : 'Vlastním tempem';
const fmtPrice = (czk: number) => czk === 0 ? 'Zdarma' : `${czk.toLocaleString('cs-CZ')} Kč`;
const lessonCountLabel = (count: number) => count === 1
  ? '1 lekce'
  : count >= 2 && count <= 4
    ? `${count} lekce`
    : `${count} lekcí`;
const firstSlug = courses[0]?.slug;
---

<PublicLayout title="Kurzy" description="Naučte se AI krok za krokem. E-mailové kurzy pro začátečníky i firmy.">
  <section class="hero">
    <div class="wrap">
      <span class="eyebrow">⚡ E-mailové kurzy AI pro úplné začátečníky</span>
      <h1>Naučte se <span class="mk p">AI</span><br />krok za <span class="mk o">krokem</span></h1>
      <p class="sub">
        Každý pracovní den vám přijde jedna krátká lekce do e-mailu. Žádné dlouhé přednášky.
        Jeden příklad, jeden prompt, jeden úkol, který si hned vyzkoušíte.
      </p>
      <div class="cta">
        <a class="btn btn-pink btn-big" href="#kurzy">Vybrat si kurz →</a>
        <a class="btn btn-white btn-big" href="#jak">Jak to funguje</a>
      </div>
      <span class="sticker">
        <span><b>0 Kč</b><span>start zdarma</span></span>
      </span>
      <div class="stats">
        <div class="st"><b>15 min</b><span>denně stačí</span></div>
        <div class="st"><b>Po-Pá</b><span>bez víkendů</span></div>
        <div class="st"><b>0 Kč</b><span>první kurz</span></div>
      </div>
    </div>
  </section>

  <div class="marquee" aria-hidden="true">
    <div class="track">
      <span>jeden prompt denně <span class="d">●</span></span>
      <span>bez zbytečné teorie <span class="d">●</span></span>
      <span>praktické úkoly <span class="d">●</span></span>
      <span>lekce přímo v e-mailu <span class="d">●</span></span>
      <span>jeden prompt denně <span class="d">●</span></span>
      <span>bez zbytečné teorie <span class="d">●</span></span>
      <span>praktické úkoly <span class="d">●</span></span>
      <span>lekce přímo v e-mailu <span class="d">●</span></span>
    </div>
  </div>

  <section class="section" id="jak">
    <div class="wrap">
      <div class="shead">
        <h2>AI se nenaučíte koukáním. Naučíte se ji používáním.</h2>
        <p>
          Z kurzů jsme odstranili dlouhé přednášky, nejasné pojmy a prázdnou teorii.
          Každý den dostanete jednu věc, kterou si hned zkusíte.
        </p>
      </div>
      <div class="steps">
        {steps.map((step) => (
          <div class="step">
            <div class="num">{step.n}</div>
            <h3>{step.title}</h3>
            <p>{step.body}</p>
          </div>
        ))}
      </div>
      <p class="closing">
        Za pár minut denně si vybudujete návyk, díky kterému AI opravdu začnete používat.
      </p>
    </div>
  </section>

  <section class="section courses" id="kurzy">
    <div class="wrap">
      <div class="shead">
        <h2>Vyberte si kurz</h2>
        <p>Začněte tématem, které vám pomůže hned v běžném dni.</p>
      </div>
      {courses.length === 0 ? (
        <p style="color:#fff;font-weight:700;margin-top:28px">Kurzy se brzy objeví.</p>
      ) : (
        <div class="grid">
          {courses.map((course) => (
            <a class="pcard" href={`/kurz/${course.slug}`}>
              <div class="hd">
                <span>{course.price_czk === 0 ? 'Start zdarma' : 'Kurz'}</span>
                <span>{lessonCountLabel(course.lesson_count)}</span>
              </div>
              <div class="bd">
                <h3>{course.title}</h3>
                <p class="perex">{course.perex}</p>
                <div class="foot">
                  <span class={`ptag ${course.price_czk === 0 ? 'free' : 'paid'}`}>{fmtPrice(course.price_czk)}</span>
                  <span class="go">{deliveryLabel(course.delivery_mode)} →</span>
                </div>
              </div>
            </a>
          ))}
        </div>
      )}
    </div>
  </section>

  <section class="section tband">
    <div class="wrap">
      <div class="tgrid">
        {testimonials.map((item) => (
          <div class="tcard">
            <div class="stars">★★★★★</div>
            <p>„{item.quote}“</p>
            <div class="who">
              <span class="av" style={`background:${item.color}`}>{item.name.charAt(0)}</span>
              <span>
                <span class="nm">{item.name}</span><br />
                <span class="rl">{item.role}</span>
              </span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section fcta">
    <div class="wrap">
      <div class="box">
        <div class="dec" style="width:220px;height:220px;background:rgba(255,255,255,.10);top:-60px;right:-40px"></div>
        <div class="dec" style="width:140px;height:140px;background:rgba(255,255,255,.08);bottom:-50px;left:30px"></div>
        <div style="position:relative;z-index:2">
          <h2>Začněte už zítra ráno</h2>
          <p>První lekce dorazí další pracovní den. Bez závazků, kdykoli můžete přestat.</p>
          {firstSlug && <a class="btn btn-orange btn-big" href={`/kurz/${firstSlug}`}>Zapsat se zdarma →</a>}
        </div>
      </div>
    </div>
  </section>
</PublicLayout>
