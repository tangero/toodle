---
/**
 * Veřejná ukázková lekce: první lekce publikovaného kurzu tak, jak přijde e-mailem.
 * Když kurz nebo lekce chybí (nebo je lekce prázdná), vracíme čtenáře na stránku kurzu.
 */
import SiteLayout from '@layouts/SiteLayout.astro';
import { getOne } from '@lib/db';
import { renderMarkdown } from '@lib/markdown';
import type { Course, Lesson } from '@lib/types';
import { env } from '@lib/env';
import { priceLabel } from '@lib/labels';

const { slug } = Astro.params;

const course = await getOne<Course>(
  env.DB,
  `SELECT * FROM courses WHERE slug = ? AND status = 'published'`,
  slug,
);
if (!course) return Astro.redirect(`/kurz/${slug}`);

const lesson = await getOne<Lesson>(
  env.DB,
  `SELECT * FROM lessons WHERE course_id = ? AND position = 1`,
  course.id,
);
if (!lesson || !lesson.content_md?.trim()) return Astro.redirect(`/kurz/${course.slug}`);

const lessonHtml = renderMarkdown(lesson.content_md);
const free = course.price_czk === 0;
---

<SiteLayout
  title={`Ukázková lekce: ${lesson.title}`}
  description={`První lekce kurzu ${course.title} k přečtení bez zápisu.`}
>
  <div class="wrap">
    <a class="back" href={`/kurz/${course.slug}`}>← Zpět na kurz {course.title}</a>

    <header class="page-head">
      <p class="mono">Ukázková lekce kurzu {course.title}</p>
      <h1>{lesson.title}</h1>
      <p class="mono">
        Lekce 1 z {course.lesson_count}{lesson.reading_minutes > 0 ? ` · ${lesson.reading_minutes} minut čtení` : ''}
      </p>
    </header>

    <div class="page-body">
      <article class="prose" set:html={lessonHtml} />

      <section>
        <div class="band">
          <div class="txt">
            <h2>Chcete dostávat i další lekce?</h2>
            <p class="muted measure">
              Zapište se do kurzu {course.title} a lekce vám budou chodit do e-mailu. Kurz můžete kdykoli pozastavit.
            </p>
          </div>
          <div class="act">
            <a class="btn btn-accent" href={`/objednavka/${course.slug}`}>
              {free ? 'Zapsat se zdarma' : `Objednat za ${priceLabel(course.price_czk)}`}
            </a>
            <a class="back" href={`/kurz/${course.slug}`}>Osnova a podrobnosti kurzu</a>
          </div>
        </div>
      </section>
    </div>
  </div>
</SiteLayout>
