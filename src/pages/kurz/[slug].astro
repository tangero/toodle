---
import SiteLayout from '@layouts/SiteLayout.astro';
import { getOne, getAll } from '@lib/db';
import { renderMarkdown } from '@lib/markdown';
import type { Course, Lesson } from '@lib/types';
import { env } from '@lib/env';
import { deliveryLabel, lessonCountLabel, priceLabel } from '@lib/labels';

const { slug } = Astro.params;

const course = await getOne<Course>(
  env.DB,
  `SELECT * FROM courses WHERE slug = ? AND status = 'published'`,
  slug,
);

if (!course) {
  return Astro.redirect('/404');
}

const lessons = await getAll<Lesson>(
  env.DB,
  `SELECT id, position, title, reading_minutes FROM lessons WHERE course_id = ? ORDER BY position ASC`,
  course.id,
);

// Odkaz na ukázku dáváme jen tehdy, když má první lekce nějaký text.
const sample = await getOne<{ id: string }>(
  env.DB,
  `SELECT id FROM lessons WHERE course_id = ? AND position = 1 AND trim(content_md) != ''`,
  course.id,
);

const descriptionHtml = renderMarkdown(course.description_md);
const totalMinutes = lessons.reduce((sum, lesson) => sum + (lesson.reading_minutes || 0), 0);
const free = course.price_czk === 0;
---

<SiteLayout title={course.title} description={course.perex}>
  <div class="wrap">
    <a class="back" href="/#kurzy">← Všechny kurzy</a>

    <header class="page-head">
      <h1>{course.title}</h1>
      <p class="lead">{course.perex}</p>
    </header>

    <dl class="facts text">
      {course.audience && <div><dt>Pro koho</dt><dd>{course.audience}</dd></div>}
      {course.requirements && <div><dt>Co potřebujete</dt><dd>{course.requirements}</dd></div>}
      <div>
        <dt>Rozsah</dt>
        <dd>{`${lessonCountLabel(course.lesson_count)}, ${deliveryLabel(course.delivery_mode)}${totalMinutes > 0 ? `, celkem asi ${totalMinutes} minut čtení` : ''}`}</dd>
      </div>
    </dl>

    <div class="layout">
      <aside class="aside box enroll">
        <p class="box-head">Zápis do kurzu</p>
        <div class="box-body">
          <p class="price">{priceLabel(course.price_czk)}</p>
          <ul>
            <li>{lessonCountLabel(course.lesson_count)} přímo do e-mailu</li>
            <li>Zadání připravená ke zkopírování</li>
            <li>Test a certifikát na závěr</li>
            <li>Kurz můžete kdykoli pozastavit</li>
          </ul>
          <a class="btn btn-accent" href={`/objednavka/${course.slug}`}>
            {free ? 'Zapsat se zdarma' : `Objednat za ${priceLabel(course.price_czk)}`}
          </a>
          {sample && <a class="more" href={`/kurz/${course.slug}/ukazka`}>Přečíst ukázkovou lekci</a>}
          <p class="mono">Píše {course.author_name}. Po potvrzení e-mailu vám pošleme první lekci.</p>
        </div>
      </aside>

      <div class="content">
        {course.description_md && <div class="prose" set:html={descriptionHtml} />}

        {lessons.length > 0 && (
          <section class="stack">
            <h2>Osnova kurzu</h2>
            <ol class="outline">
              {lessons.map((lesson) => (
                <li>
                  <span class="lt">{lesson.title}</span>
                  <span class="lm">{lesson.reading_minutes} min</span>
                </li>
              ))}
            </ol>
          </section>
        )}
      </div>

    </div>
  </div>
</SiteLayout>
