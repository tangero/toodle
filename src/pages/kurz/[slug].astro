---
import PublicLayout from '@layouts/PublicLayout.astro';
import { getOne, getAll } from '@lib/db';
import { renderMarkdown } from '@lib/markdown';
import type { Course, Lesson } from '@lib/types';
import { env } from '@lib/env';

const { slug } = Astro.params;

const course = await getOne<Course>(
  env.DB,
  `SELECT * FROM courses WHERE slug = ? AND status = 'published'`,
  slug,
);

if (!course) {
  return Astro.redirect('/404');
}

const lessons = await getAll<Lesson>(
  env.DB,
  `SELECT id, position, title, reading_minutes FROM lessons WHERE course_id = ? ORDER BY position ASC`,
  course.id,
);

const descriptionHtml = renderMarkdown(course.description_md);
const deliveryLabel = course.delivery_mode === 'next_workday' ? 'Automaticky Po-Pá' : 'Vlastním tempem';
const totalMinutes = lessons.reduce((sum, lesson) => sum + (lesson.reading_minutes || 0), 0);
const fmtPrice = (czk: number) => czk === 0 ? 'Zdarma' : `${czk.toLocaleString('cs-CZ')} Kč`;
const lessonCountLabel = (count: number) => count === 1
  ? '1 lekce'
  : count >= 2 && count <= 4
    ? `${count} lekce`
    : `${count} lekcí`;
const checkSvg = '<svg class="ck" width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M5 12.5l4.5 4.5L19 6" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/></svg>';
---

<PublicLayout title={course.title} description={course.perex}>
  <div class="wrap" style="padding-top:8px">
    <a class="back" href="/">← Zpět na kurzy</a>
    <div class="cd">
      <div>
        <span class="tag" style={`background:${course.price_czk === 0 ? '#7c3aed' : '#ec4899'}`}>
          {course.price_czk === 0 ? 'Start zdarma' : 'Kurz'}
        </span>
        <h1>{course.title}</h1>
        <p class="lead">{course.perex}</p>
        <div class="chips">
          <span class="chip">{lessonCountLabel(course.lesson_count)}</span>
          <span class="chip">{deliveryLabel}</span>
          {totalMinutes > 0 && <span class="chip">~{totalMinutes} min celkem</span>}
          <span class="chip">{course.author_name}</span>
        </div>

        {course.description_md && (
          <div class="desc" set:html={descriptionHtml} />
        )}

        {lessons.length > 0 && (
          <div class="outline">
            <h2>Osnova kurzu</h2>
            {lessons.map((lesson) => (
              <div class="lesson">
                <div class="pos">{lesson.position}</div>
                <span class="lt">{lesson.title}</span>
                <span class="lm">{lesson.reading_minutes} min</span>
              </div>
            ))}
          </div>
        )}
      </div>

      <aside>
        <div class="buy">
          <div class={`price ${course.price_czk === 0 ? 'free' : ''}`}>{fmtPrice(course.price_czk)}</div>
          <div class="pn">{course.price_czk === 0 ? 'Žádná karta, žádné závazky' : 'Jednorázově za celý kurz'}</div>
          <ul>
            <li><Fragment set:html={checkSvg} /> {lessonCountLabel(course.lesson_count)} přímo do e-mailu</li>
            <li><Fragment set:html={checkSvg} /> Připravené prompty ke zkopírování</li>
            <li><Fragment set:html={checkSvg} /> Test a certifikát na závěr</li>
            <li><Fragment set:html={checkSvg} /> Tempo kdykoli pozastavíte</li>
          </ul>
          <a class="btn btn-pink btn-big" href={`/objednavka/${course.slug}`}>
            {course.price_czk === 0 ? 'Zapsat se zdarma →' : `Objednat za ${fmtPrice(course.price_czk)} →`}
          </a>
          <div class="note">Po přihlášení vám pošleme první lekci.</div>
        </div>
      </aside>
    </div>
  </div>
</PublicLayout>
