---
import SiteLayout from '@layouts/SiteLayout.astro';
import { getOne } from '@lib/db';
import TestForm from '@components/TestForm';
import type { Enrollment, Course, Test, TestQuestion } from '@lib/types';
import { env } from "@lib/env";

const { enrollmentId } = Astro.params;
const user = Astro.locals.user!;

const enrollment = await getOne<Enrollment>(
  env.DB,
  `SELECT * FROM enrollments WHERE id = ? AND user_id = ?`,
  enrollmentId,
  user.id,
);
if (!enrollment || enrollment.status !== 'completed') return Astro.redirect('/profil');

const previousScore = enrollment.score;

const course = await getOne<Course>(
  env.DB, `SELECT * FROM courses WHERE id = ?`, enrollment.course_id,
);
if (!course) return Astro.redirect('/profil');

const testRow = await getOne<Test>(
  env.DB, `SELECT * FROM tests WHERE course_id = ?`, enrollment.course_id,
);
if (!testRow) return Astro.redirect(`/profil/kurz/${enrollmentId}`);

const allQuestions: TestQuestion[] = JSON.parse(testRow.questions_json);
if (allQuestions.length === 0) return Astro.redirect(`/profil/kurz/${enrollmentId}`);

// Do prohlížeče posíláme otázky BEZ správných odpovědí (props ostrůvku jsou vidět ve zdrojáku stránky).
const questions: TestQuestion[] = allQuestions.map(({ id, type, question, options, max_points }) => ({
  id, type, question, max_points,
  options: options?.map((o) => ({ id: o.id, text: o.text })),
}));
---

<SiteLayout title={`Závěrečný test: ${course.title}`}>
  <div class="wrap">
    <a class="back" href={`/profil/kurz/${enrollmentId}`}>← Zpět na kurz</a>

    <header class="page-head">
      <p class="mono">Závěrečný test</p>
      <h1>{course.title}</h1>
      <p class="mono">Počet otázek: {questions.length} · k certifikátu potřebujete alespoň 70 %</p>
    </header>

    <div class="page-body measure">
      {previousScore !== null && (
        <div class="note">
          <p>Váš předchozí výsledek je <strong>{previousScore} %</strong>. Test můžete zopakovat a skóre si zlepšit.</p>
        </div>
      )}

      <TestForm
        client:load
        enrollmentId={enrollmentId!}
        questions={questions}
      />
    </div>
  </div>
</SiteLayout>
