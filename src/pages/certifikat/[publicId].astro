---
import SiteLayout from '@layouts/SiteLayout.astro';
import { getOne } from '@lib/db';
import type { Certificate } from '@lib/types';
import { env } from '@lib/env';

const { publicId } = Astro.params;

interface CertificateDetail extends Certificate {
  user_name: string;
  user_email: string;
  course_title: string;
  enrollment_score: number | null;
}

const cert = await getOne<CertificateDetail>(
  env.DB,
  `SELECT c.*, u.name as user_name, u.email as user_email,
          co.title as course_title, e.score as enrollment_score
   FROM certificates c
   JOIN enrollments e ON c.enrollment_id = e.id
   JOIN users u ON e.user_id = u.id
   JOIN courses co ON e.course_id = co.id
   WHERE c.public_id = ?`,
  publicId,
);

if (!cert) {
  return Astro.redirect('/404');
}

const issuedDate = new Date(cert.issued_at).toLocaleDateString('cs-CZ', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---

<SiteLayout
  title={`Certifikát: ${cert.course_title}`}
  description={`Ověření certifikátu o absolvování kurzu ${cert.course_title} ve Škole AI.`}
>
  <div class="wrap">
    <div class="page-body measure">
      <article class="box cert">
        <p class="mono">Certifikát o absolvování kurzu</p>
        <h1>{cert.course_title}</h1>
        <div>
          <p class="holder">{cert.user_name}</p>
          <p class="muted">úspěšně dokončil/a kurz Školy AI</p>
        </div>
        <dl class="facts">
          {cert.enrollment_score !== null && (
            <div><dt>Skóre testu</dt><dd>{cert.enrollment_score} %</dd></div>
          )}
          <div><dt>Vydáno</dt><dd>{issuedDate}</dd></div>
        </dl>
        <a class="btn" href={`/api/certificates/${publicId}`}>Stáhnout PDF</a>
      </article>

      <p class="mono">
        Pravost certifikátu ověřuje tato stránka Školy AI. Kód certifikátu: {cert.public_id}
      </p>
    </div>
  </div>
</SiteLayout>
