---
import SiteLayout from '@layouts/SiteLayout.astro';

const status = Astro.url.searchParams.get('status');
---

<SiteLayout title="Ověření e-mailu">
  <div class="wrap">
    {status === 'ok' && (
      <>
        <header class="page-head">
          <h1>E-mail je ověřený</h1>
          <p class="lead">Váš e-mail jsme ověřili. Pokračovat můžete ve svém profilu.</p>
        </header>
        <div class="page-body narrow">
          <p class="actions"><a class="btn" href="/profil">Přejít do profilu</a></p>
        </div>
      </>
    )}

    {status === 'invalid' && (
      <>
        <header class="page-head">
          <h1>Odkaz není platný</h1>
          <p class="lead">Odkaz pro ověření vypršel nebo už byl použit. Na stránce přihlášení si nechte poslat nový.</p>
        </header>
        <div class="page-body narrow">
          <p class="actions"><a class="btn" href="/prihlaseni">Přejít na přihlášení</a></p>
        </div>
      </>
    )}

    {status !== 'ok' && status !== 'invalid' && (
      <>
        <header class="page-head">
          <h1>Ověření se nepodařilo</h1>
          <p class="lead">E-mail se nepodařilo ověřit. Otevřete odkaz z e-mailu znovu, nebo si na stránce přihlášení nechte poslat nový.</p>
        </header>
        <div class="page-body narrow">
          <p class="actions"><a class="btn" href="/prihlaseni">Přejít na přihlášení</a></p>
        </div>
      </>
    )}
  </div>
</SiteLayout>
