---
import PublicLayout from '@layouts/PublicLayout.astro';
import { getOne, getAll } from '@lib/db';
import type { Enrollment, Course, Lesson, Certificate } from '@lib/types';
import { env } from "@lib/env";

const { id } = Astro.params;
const user = Astro.locals.user!;

const enrollment = await getOne<Enrollment>(
  env.DB,
  `SELECT * FROM enrollments WHERE id = ? AND user_id = ?`,
  id,
  user.id,
);

if (!enrollment) {
  return Astro.redirect('/profil');
}

const course = await getOne<Course>(
  env.DB,
  `SELECT * FROM courses WHERE id = ?`,
  enrollment.course_id,
);

if (!course) {
  return Astro.redirect('/profil');
}

const lessons = await getAll<Lesson>(
  env.DB,
  `SELECT * FROM lessons WHERE course_id = ? ORDER BY position ASC`,
  course.id,
);

const certificate = await getOne<Certificate>(
  env.DB,
  `SELECT * FROM certificates WHERE enrollment_id = ?`,
  enrollment.id,
);

const hasTest = !!(await getOne<{ id: string }>(
  env.DB,
  `SELECT id FROM tests WHERE course_id = ? AND questions_json != '[]'`,
  course.id,
));

const canContinue = (enrollment.status === 'active' || enrollment.status === 'stalled') && course.delivery_mode === 'on_click';
const canPause = ['active', 'stalled', 'paused'].includes(enrollment.status);

const statusLabels: Record<string, string> = {
  pending: 'Čeká na potvrzení e-mailu',
  active: 'Aktivní',
  paused: 'Pozastaveno',
  stalled: 'Neaktivní',
  completed: 'Dokončeno',
  cancelled: 'Zrušeno',
};
---

<PublicLayout title={course.title}>
  <div class="mx-auto max-w-3xl py-8">
    <a href="/profil" class="text-sm text-gray-500 hover:text-gray-700">&larr; Zpět na profil</a>

    <header class="mt-4">
      <h1 class="text-2xl font-bold text-gray-900">{course.title}</h1>
      <div class="mt-2 flex items-center gap-3">
        <span class="rounded-full bg-gray-100 px-3 py-1 text-sm font-medium text-gray-700">
          {statusLabels[enrollment.status] || enrollment.status}
        </span>
        <span class="text-sm text-gray-500">
          Lekce {Math.min(enrollment.current_lesson, course.lesson_count)} z {course.lesson_count}
        </span>
      </div>
    </header>

    {enrollment.status === 'pending' && (
      <div class="mt-6 rounded-lg bg-yellow-50 p-4 text-sm text-yellow-900">
        Zápis čeká na potvrzení e-mailu. Klikněte na odkaz v potvrzovacím e-mailu – lekce začnou chodit hned potom.
      </div>
    )}

    {enrollment.status === 'completed' && (
      <div class="mt-6 rounded-lg bg-green-50 p-4">
        <p class="font-medium text-green-800">Kurz byl dokončen!</p>
        {enrollment.score !== null && (
          <p class="mt-1 text-sm text-green-800">Nejlepší výsledek testu: <strong>{enrollment.score} %</strong></p>
        )}
        <div class="mt-2 flex flex-wrap gap-3">
          {hasTest && !certificate && (
            <a href={`/test/${enrollment.id}`} class="rounded-lg bg-green-600 px-4 py-2 text-sm font-medium text-white hover:bg-green-700">
              {enrollment.score === null ? 'Složit závěrečný test' : 'Zkusit test znovu'}
            </a>
          )}
          {certificate && (
            <a href={`/certifikat/${certificate.public_id}`} class="rounded-lg bg-blue-600 px-4 py-2 text-sm font-medium text-white hover:bg-blue-700">
              Zobrazit certifikát
            </a>
          )}
          {hasTest && certificate && (enrollment.score ?? 0) < 100 && (
            <a href={`/test/${enrollment.id}`} class="rounded-lg border border-green-600 px-4 py-2 text-sm font-medium text-green-700 hover:bg-green-100">
              Zlepšit skóre
            </a>
          )}
        </div>
      </div>
    )}

    <section class="mt-8">
      <h2 class="text-lg font-semibold text-gray-900">Lekce</h2>
      <ol class="mt-4 space-y-2">
        {lessons.map((lesson) => {
          const isCompleted = lesson.position < enrollment.current_lesson;
          const isCurrent = lesson.position === enrollment.current_lesson;
          return (
            <li class:list={[
              'flex items-center gap-3 rounded-lg border px-4 py-3',
              isCompleted ? 'border-green-200 bg-green-50' : isCurrent ? 'border-blue-200 bg-blue-50' : 'border-gray-100',
            ]}>
              <span class:list={[
                'flex h-7 w-7 shrink-0 items-center justify-center rounded-full text-xs font-medium',
                isCompleted ? 'bg-green-200 text-green-700' : isCurrent ? 'bg-blue-200 text-blue-700' : 'bg-gray-100 text-gray-500',
              ]}>
                {isCompleted ? '\u2713' : lesson.position}
              </span>
              <span class:list={['text-gray-900', isCompleted && 'line-through opacity-60']}>
                {lesson.title}
              </span>
              <span class="ml-auto text-xs text-gray-400">{lesson.reading_minutes} min</span>
            </li>
          );
        })}
      </ol>
    </section>

    {canContinue && (
      <div class="mt-6 text-center">
        <button
          id="mark-done"
          class="rounded-lg bg-blue-600 px-6 py-2 font-medium text-white hover:bg-blue-700"
          data-enrollment-id={enrollment.id}
        >
          Mám přečteno – pošlete další lekci
        </button>
        <p id="done-msg" class="mt-2 text-sm text-gray-600" role="status"></p>
      </div>
    )}

    {canPause && (
      <div class="mt-6 text-center">
        <button
          id="toggle-pause"
          class="rounded-lg border border-gray-300 px-5 py-2 text-sm text-gray-700 hover:bg-gray-50"
          data-enrollment-id={enrollment.id}
        >
          {enrollment.status === 'paused' ? 'Obnovit kurz' : 'Pozastavit kurz'}
        </button>
      </div>
    )}

    <script>
      const msg = document.getElementById('done-msg');
      document.getElementById('mark-done')?.addEventListener('click', async (e) => {
        const btn = e.currentTarget as HTMLButtonElement;
        const label = btn.textContent;
        btn.disabled = true;
        btn.textContent = 'Odesílám…';
        const res = await fetch(`/api/enrollments/${btn.dataset.enrollmentId}/done`, { method: 'POST' });
        if (res.ok) {
          window.location.reload();
          return;
        }
        const data = await res.json().catch(() => ({})) as { error?: string };
        btn.disabled = false;
        btn.textContent = label;
        if (msg) msg.textContent = data.error ?? 'Nastala chyba, zkuste to prosím znovu.';
      });

      document.getElementById('toggle-pause')?.addEventListener('click', async (e) => {
        const btn = e.currentTarget as HTMLButtonElement;
        btn.disabled = true;
        const res = await fetch(`/api/enrollments/${btn.dataset.enrollmentId}/pause`, { method: 'POST' });
        if (res.ok) window.location.reload();
        else btn.disabled = false;
      });
    </script>
  </div>
</PublicLayout>
