---
import SiteLayout from '@layouts/SiteLayout.astro';
import { getOne, getAll } from '@lib/db';
import type { Enrollment, Course, Lesson, Certificate } from '@lib/types';
import { env } from '@lib/env';
import { enrollmentStatusLabel } from '@lib/labels';
import { FEEDBACK_ANSWERS, FEEDBACK_LABELS, type FeedbackAnswer } from '@lib/feedback';
import { createFeedbackToken } from '@lib/unsubscribe';

const { id } = Astro.params;
const user = Astro.locals.user!;

const enrollment = await getOne<Enrollment>(
  env.DB,
  `SELECT * FROM enrollments WHERE id = ? AND user_id = ?`,
  id,
  user.id,
);

if (!enrollment) {
  return Astro.redirect('/profil');
}

const course = await getOne<Course>(
  env.DB,
  `SELECT * FROM courses WHERE id = ?`,
  enrollment.course_id,
);

if (!course) {
  return Astro.redirect('/profil');
}

const lessons = await getAll<Lesson>(
  env.DB,
  `SELECT * FROM lessons WHERE course_id = ? ORDER BY position ASC`,
  course.id,
);

const certificate = await getOne<Certificate>(
  env.DB,
  `SELECT * FROM certificates WHERE enrollment_id = ?`,
  enrollment.id,
);

const hasTest = !!(await getOne<{ id: string }>(
  env.DB,
  `SELECT id FROM tests WHERE course_id = ? AND questions_json != '[]'`,
  course.id,
));

const canContinue = (enrollment.status === 'active' || enrollment.status === 'stalled') && course.delivery_mode === 'on_click';
const canPause = ['active', 'stalled', 'paused'].includes(enrollment.status);

// Zpětná vazba na srozumitelnost (jen kurzy na potvrzení). `current_lesson` ukazuje na lekci,
// která se pošle příště, takže právě dočtená lekce má pozici o jednu nižší.
const readPosition = enrollment.current_lesson - 1;
const readLesson = lessons.find((lesson) => lesson.position === readPosition);
// U poslední lekce (kurz je už dokončený) se na srozumitelnost ptáme, dokud čtenář neodpoví.
const lastLessonAnswered = course.delivery_mode === 'on_click' && enrollment.status === 'completed' && readLesson
  ? !!(await getOne<{ id: string }>(
      env.DB, `SELECT id FROM lesson_feedback WHERE enrollment_id = ? AND lesson_id = ?`, enrollment.id, readLesson.id,
    ))
  : true;
const askLastLesson = !lastLessonAnswered && enrollment.score === null && !certificate;

// Během kurzu je odpověď na srozumitelnost oddělená od postupu: uloží se přes stránku
// /srozumitelnost (nic neposílá) a další lekci pošle až tlačítko „Mám přečteno“.
// Čtenáři si dřív odpověď pletli s potvrzením a kurz jim „utekl“ o lekci dál.
const readToken = canContinue && readLesson
  ? await createFeedbackToken(enrollment.id, readLesson.id, env.JWT_SECRET)
  : null;
const readAnswer = readToken && readLesson
  ? (await getOne<{ answer: FeedbackAnswer }>(
      env.DB, `SELECT answer FROM lesson_feedback WHERE enrollment_id = ? AND lesson_id = ?`, enrollment.id, readLesson.id,
    ))?.answer ?? null
  : null;
const answerSaved = Astro.url.searchParams.get('srozumitelnost') === 'ulozeno';

// Lekce, které už odešly, jdou číst i na webu. `current_lesson` ukazuje na lekci, která se pošle příště.
const isSent = (position: number) =>
  enrollment.status !== 'pending' && (position < enrollment.current_lesson || enrollment.status === 'completed');

const TEST_LABELS: Record<FeedbackAnswer, string> = {
  1: 'Rozuměl jsem, přejít k testu',
  2: 'Něco mi nesedělo, přejít k testu',
  3: FEEDBACK_LABELS[3],
};
const answerLabels = hasTest ? TEST_LABELS : FEEDBACK_LABELS;

// Chyby po odeslání formuláře bez JavaScriptu (endpoint přesměruje zpět s parametrem).
const doneErrors: Record<string, string> = {
  'odesila-se': 'Lekce se právě odesílá, zkuste to za chvíli.',
  odeslani: 'Lekci se nepodařilo odeslat. Zkuste to prosím za chvíli.',
  odpoved: 'Odpověď se nepodařilo rozpoznat. Zkuste to prosím znovu.',
  stav: 'Kurz teď není aktivní, další lekci poslat nejde.',
};
const doneError = doneErrors[Astro.url.searchParams.get('chyba') ?? ''];
---

<SiteLayout title={course.title}>
  <div class="wrap">
    <a class="back" href="/profil">← Zpět na profil</a>

    <header class="page-head">
      <h1>{course.title}</h1>
      <p class="meta-row">
        <span class="tag">{enrollmentStatusLabel(enrollment.status)}</span>
        <span class="mono">Lekce {Math.min(enrollment.current_lesson, course.lesson_count)} z {course.lesson_count}</span>
      </p>
    </header>

    <div class="page-body">
      {enrollment.status === 'pending' && (
        <div class="note">
          <p><strong>Zápis čeká na potvrzení e-mailu.</strong></p>
          <p>Otevřete potvrzovací e-mail a klikněte v něm na odkaz. Lekce začnou chodit hned potom.</p>
          {course.price_czk === 0 && (
            <p class="actions">
              <a class="btn btn-line" href={`/objednavka/${course.slug}`}>Potvrdit zápis tady</a>
            </p>
          )}
        </div>
      )}

      {enrollment.status === 'paused' && (
        <div class="note">
          <p><strong>Kurz je pozastavený.</strong></p>
          <p>Další lekce vám teď nechodí. Až budete chtít pokračovat, kurz obnovte tlačítkem pod seznamem lekcí.</p>
        </div>
      )}

      {enrollment.status === 'completed' && (
        <div class="note ok">
          <p><strong>Kurz máte dokončený.</strong></p>
          {enrollment.score !== null && (
            <p>Nejlepší výsledek testu: <strong>{enrollment.score} %</strong></p>
          )}
          {((hasTest && !askLastLesson) || certificate) && (
            <div class="actions">
              {hasTest && !certificate && !askLastLesson && (
                <a class="btn" href={`/test/${enrollment.id}`}>
                  {enrollment.score === null ? 'Složit závěrečný test' : 'Zkusit test znovu'}
                </a>
              )}
              {certificate && (
                <a class="btn" href={`/certifikat/${certificate.public_id}`}>Zobrazit certifikát</a>
              )}
              {hasTest && certificate && (enrollment.score ?? 0) < 100 && (
                <a class="btn btn-line" href={`/test/${enrollment.id}`}>Zlepšit skóre</a>
              )}
            </div>
          )}
        </div>
      )}

      <section>
        <h2>Lekce</h2>
        <ol class="outline">
          {lessons.map((lesson) => {
            const sent = isSent(lesson.position);
            // Poslední odeslaná lekce je ta, kterou čtenář právě čte; hotové jsou jen starší.
            const isReading = sent && lesson.position === readPosition && enrollment.status !== 'completed';
            const isDone = sent && !isReading;
            return (
              <li class:list={[isDone && 'done', isReading && 'now']} aria-current={isReading ? 'step' : undefined}>
                <span class="lt">
                  {sent
                    ? <a href={`/profil/kurz/${enrollment.id}/lekce/${lesson.position}`}>{lesson.title}</a>
                    : lesson.title}
                </span>
                <span class="lm">
                  {isDone ? 'hotovo · ' : isReading ? 'čtete teď · ' : ''}{lesson.reading_minutes} min
                </span>
              </li>
            );
          })}
        </ol>
      </section>

      {(canContinue || canPause || askLastLesson) && (
        <div class="stack">
          {/* Tři odpovědi mají stejný vzhled a stálé pořadí. Žádná není zvýrazněná a žádná postup neblokuje. */}
          {readToken && readLesson && (
            <form method="post" action={`/api/feedback/${readToken}/answer`}>
              <input type="hidden" name="z" value="kurz" />
              <fieldset class="question plain">
                <legend>Jak srozumitelná byla lekce {readLesson.position}?</legend>
                <p class="hint">
                  Odpověď je dobrovolná a další lekci neposílá. Tu si vyžádáte tlačítkem níže, až budete mít přečteno.
                </p>
                <div class="answers">
                  {FEEDBACK_ANSWERS.map((answer) => (
                    <button type="submit" name="answer" value={answer} class="btn" aria-pressed={readAnswer === answer ? 'true' : 'false'}>
                      {FEEDBACK_LABELS[answer]}
                    </button>
                  ))}
                </div>
                {readAnswer !== null && (
                  <p class="hint" role={answerSaved ? 'status' : undefined}>
                    {answerSaved ? 'Děkujeme, odpověď je uložená' : 'Vaše odpověď'}: {FEEDBACK_LABELS[readAnswer]}. Jiným tlačítkem ji změníte.
                  </p>
                )}
              </fieldset>
            </form>
          )}
          {askLastLesson && readLesson && (
            <form method="post" action={`/api/enrollments/${enrollment.id}/done`} id="feedback-form" data-enrollment-id={enrollment.id}>
              {/* Pozice lekce, ke které se otázka zobrazila: odpověď ze staré karty se nepřipíše jiné lekci. */}
              <input type="hidden" name="lesson" value={readLesson.position} />
              <fieldset class="question plain">
                <legend>Jak srozumitelná byla lekce {readLesson.position}?</legend>
                <p class="hint">
                  {hasTest ? 'Odpověď uložíme a přejdete k závěrečnému testu.' : 'Odpověď nám pomůže lekci vylepšit.'}
                </p>
                <div class="answers">
                  {FEEDBACK_ANSWERS.map((answer) => (
                    <button type="submit" name="answer" value={answer} class="btn">{answerLabels[answer]}</button>
                  ))}
                </div>
              </fieldset>
            </form>
          )}
          <div class="actions">
            {canContinue && (
              <button type="button" id="mark-done" class="btn" data-enrollment-id={enrollment.id}>
                {readLesson ? 'Mám přečteno, pošlete další lekci' : 'Pošlete mi další lekci'}
              </button>
            )}
            {canPause && (
              <button type="button" id="toggle-pause" class="btn btn-line" data-enrollment-id={enrollment.id}>
                {enrollment.status === 'paused' ? 'Obnovit kurz' : 'Pozastavit kurz'}
              </button>
            )}
          </div>
          <div aria-live="polite">
            <p id="done-msg" class="note err" hidden={!doneError}>{doneError}</p>
          </div>
        </div>
      )}
    </div>
  </div>

  <script>
    const msg = document.getElementById('done-msg');
    const showMsg = (text: string) => {
      if (!msg) return;
      msg.textContent = text;
      msg.hidden = false;
    };

    // Odpověď na srozumitelnost poslední lekce (kurz je dočtený): zapíše odpověď a vede k testu.
    // Bez JavaScriptu se formulář odešle běžně a server přesměruje.
    const feedbackForm = document.getElementById('feedback-form') as HTMLFormElement | null;
    feedbackForm?.addEventListener('submit', async (e) => {
      const btn = (e as SubmitEvent).submitter as HTMLButtonElement | null;
      if (!btn) return;
      e.preventDefault();
      const buttons = Array.from(feedbackForm.querySelectorAll<HTMLButtonElement>('button[name="answer"]'));
      const label = btn.textContent;
      buttons.forEach((b) => { b.disabled = true; });
      btn.textContent = 'Odesílám…';
      if (msg) msg.hidden = true;
      try {
        const res = await fetch(`/api/enrollments/${feedbackForm.dataset.enrollmentId}/done`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            answer: Number(btn.value),
            lesson: Number(new FormData(feedbackForm).get('lesson')),
          }),
        });
        const data = await res.json().catch(() => ({})) as { error?: string; next?: string };
        if (res.ok) {
          if (data.next && data.next !== window.location.pathname) window.location.assign(data.next);
          else window.location.assign(window.location.pathname);
          return;
        }
        showMsg(data.error ?? 'Další lekci se nepodařilo odeslat. Zkuste to prosím znovu.');
      } catch {
        showMsg('Další lekci se nepodařilo odeslat. Zkontrolujte připojení k internetu a zkuste to znovu.');
      }
      buttons.forEach((b) => { b.disabled = false; });
      btn.textContent = label;
    });

    document.getElementById('mark-done')?.addEventListener('click', async (e) => {
      const btn = e.currentTarget as HTMLButtonElement;
      const label = btn.textContent;
      btn.disabled = true;
      btn.textContent = 'Odesílám…';
      if (msg) msg.hidden = true;
      try {
        const res = await fetch(`/api/enrollments/${btn.dataset.enrollmentId}/done`, { method: 'POST' });
        if (res.ok) {
          window.location.reload();
          return;
        }
        const data = await res.json().catch(() => ({})) as { error?: string };
        showMsg(data.error ?? 'Další lekci se nepodařilo odeslat. Zkuste to prosím znovu.');
      } catch {
        showMsg('Další lekci se nepodařilo odeslat. Zkontrolujte připojení k internetu a zkuste to znovu.');
      }
      btn.disabled = false;
      btn.textContent = label;
    });

    document.getElementById('toggle-pause')?.addEventListener('click', async (e) => {
      const btn = e.currentTarget as HTMLButtonElement;
      btn.disabled = true;
      if (msg) msg.hidden = true;
      try {
        const res = await fetch(`/api/enrollments/${btn.dataset.enrollmentId}/pause`, { method: 'POST' });
        if (res.ok) {
          window.location.reload();
          return;
        }
      } catch {
        // Chybu sítě ohlásíme stejně jako chybu serveru.
      }
      btn.disabled = false;
      showMsg('Stav kurzu se nepodařilo změnit. Zkuste to prosím znovu.');
    });
  </script>
</SiteLayout>
