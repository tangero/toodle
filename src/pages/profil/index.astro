---
import SiteLayout from '@layouts/SiteLayout.astro';
import { getAll, getOne } from '@lib/db';
import { env } from '@lib/env';
import { enrollmentStatusLabel } from '@lib/labels';

const user = Astro.locals.user;
if (!user) {
  return Astro.redirect('/prihlaseni?redirect=/profil');
}

interface Row {
  id: string;
  slug: string;
  title: string;
  lesson_count: number;
  status: string;
  current_lesson: number;
  score: number | null;
}

const enrollments = await getAll<Row>(
  env.DB,
  `SELECT e.id, e.status, e.current_lesson, e.score, c.slug, c.title, c.lesson_count
   FROM enrollments e JOIN courses c ON c.id = e.course_id
   WHERE e.user_id = ? ORDER BY e.started_at DESC`,
  user.id,
);

const certificates = await getAll<{ public_id: string; title: string; score: number | null; issued_at: string }>(
  env.DB,
  `SELECT cert.public_id, c.title, e.score, cert.issued_at
   FROM certificates cert
   JOIN enrollments e ON e.id = cert.enrollment_id
   JOIN courses c ON c.id = e.course_id
   WHERE e.user_id = ? ORDER BY cert.issued_at DESC`,
  user.id,
);

const active = enrollments.filter((enrollment) => enrollment.status === 'active');
const featured = active[0];
let nextLessonTitle: string | null = null;
if (featured) {
  const nextLesson = await getOne<{ title: string }>(
    env.DB,
    `SELECT l.title FROM lessons l JOIN courses c ON c.id = l.course_id
     WHERE c.slug = ? AND l.position = ? LIMIT 1`,
    featured.slug,
    featured.current_lesson + 1,
  );
  nextLessonTitle = nextLesson?.title ?? null;
}

const sent = (enrollment: Row) => Math.min(enrollment.current_lesson || 0, enrollment.lesson_count);
const lessonsDone = enrollments.reduce((sum, enrollment) => sum + sent(enrollment), 0);
const pct = (enrollment: Row) => enrollment.lesson_count
  ? Math.min(100, Math.round((enrollment.current_lesson / enrollment.lesson_count) * 100))
  : 0;
const fmtDate = (date: string) => new Date(date).toLocaleDateString('cs-CZ');
---

<SiteLayout title="Můj profil">
  <div class="wrap">
    <header class="page-head">
      <p class="mono">Váš profil · {user.email}</p>
      <h1>{user.name ? `Dobrý den, ${user.name}` : 'Dobrý den'}</h1>
    </header>

    <dl class="facts">
      <div><dt>Rozpracované kurzy</dt><dd>{active.length}</dd></div>
      <div><dt>Dokončené lekce</dt><dd>{lessonsDone}</dd></div>
      <div><dt>Získané certifikáty</dt><dd>{certificates.length}</dd></div>
    </dl>

    <div class="page-body">
      <div class="actions">
        <a class="btn btn-line btn-sm" href="/profil/nastaveni">Nastavení účtu</a>
        <form method="POST" action="/api/auth/logout">
          <button type="submit" class="btn btn-line btn-sm">Odhlásit se</button>
        </form>
      </div>

      {featured && (
        <section>
          <h2>Pokračujte v kurzu</h2>
          <div class="box">
            <p class="box-head">Lekce {Math.min(featured.current_lesson + 1, featured.lesson_count)} z {featured.lesson_count}</p>
            <div class="box-body">
              <h3>{featured.title}</h3>
              {nextLessonTitle && <p class="muted">Další lekce: {nextLessonTitle}</p>}
              <div class="meter" aria-hidden="true"><span style={`width:${pct(featured)}%`}></span></div>
              <p class="mono">{sent(featured)} z {featured.lesson_count} lekcí hotovo · {pct(featured)} %</p>
              <div class="actions">
                <a class="btn btn-accent" href={`/profil/kurz/${featured.id}`}>Pokračovat v kurzu</a>
                <span class="hint">Další lekce dorazí podle nastaveného tempa.</span>
              </div>
            </div>
          </div>
        </section>
      )}

      <section>
        <h2>Vaše kurzy</h2>
        {enrollments.length === 0 ? (
          <div class="note">
            <p>Zatím nejste zapsáni v žádném kurzu.</p>
            <p class="actions"><a class="btn" href="/#kurzy">Vybrat si kurz</a></p>
          </div>
        ) : (
          <div class="courses">
            {enrollments.map((enrollment) => (
              <article class="course">
                <h3><a href={`/profil/kurz/${enrollment.id}`}>{enrollment.title}</a></h3>
                <p class="col">
                  <span class="mono">Stav</span>
                  {enrollmentStatusLabel(enrollment.status)}
                </p>
                <p class="col narrow">
                  <span class="mono">{sent(enrollment)} z {enrollment.lesson_count} lekcí · {pct(enrollment)} %</span>
                  <a class="more" href={`/profil/kurz/${enrollment.id}`}>Otevřít kurz<span class="sr-only"> {enrollment.title}</span></a>
                </p>
              </article>
            ))}
          </div>
        )}
      </section>

      {certificates.length > 0 && (
        <section>
          <h2>{certificates.length === 1 ? 'Váš certifikát' : 'Vaše certifikáty'}</h2>
          <div class="courses">
            {certificates.map((cert) => (
              <article class="course">
                <h3>{cert.title}</h3>
                <p class="col">
                  <span class="mono">Certifikát o absolvování</span>
                  {cert.score != null ? `Skóre ${cert.score} %, ` : ''}vydáno {fmtDate(cert.issued_at)}
                </p>
                <p class="col narrow actions">
                  <a class="btn btn-sm" href={`/api/certificates/${cert.public_id}`}>Stáhnout PDF<span class="sr-only"> certifikátu {cert.title}</span></a>
                  <a class="more" href={`/certifikat/${cert.public_id}`}>Veřejná stránka<span class="sr-only"> certifikátu {cert.title}</span></a>
                </p>
              </article>
            ))}
          </div>
        </section>
      )}
    </div>
  </div>
</SiteLayout>
