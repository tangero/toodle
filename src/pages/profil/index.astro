---
import PublicLayout from '@layouts/PublicLayout.astro';
import { getAll, getOne } from '@lib/db';
import { env } from '@lib/env';

const user = Astro.locals.user;
if (!user) {
  return Astro.redirect('/prihlaseni?redirect=/profil');
}

interface Row {
  id: string;
  slug: string;
  title: string;
  lesson_count: number;
  status: string;
  current_lesson: number;
  score: number | null;
}

const enrollments = await getAll<Row>(
  env.DB,
  `SELECT e.id, e.status, e.current_lesson, e.score, c.slug, c.title, c.lesson_count
   FROM enrollments e JOIN courses c ON c.id = e.course_id
   WHERE e.user_id = ? ORDER BY e.started_at DESC`,
  user.id,
);

const certificates = await getAll<{ public_id: string; title: string; score: number | null; issued_at: string }>(
  env.DB,
  `SELECT cert.public_id, c.title, e.score, cert.issued_at
   FROM certificates cert
   JOIN enrollments e ON e.id = cert.enrollment_id
   JOIN courses c ON c.id = e.course_id
   WHERE e.user_id = ? ORDER BY cert.issued_at DESC`,
  user.id,
);

const active = enrollments.filter((enrollment) => enrollment.status === 'active');
const featured = active[0];
let nextLessonTitle: string | null = null;
if (featured) {
  const nextLesson = await getOne<{ title: string }>(
    env.DB,
    `SELECT l.title FROM lessons l JOIN courses c ON c.id = l.course_id
     WHERE c.slug = ? AND l.position = ? LIMIT 1`,
    featured.slug,
    featured.current_lesson + 1,
  );
  nextLessonTitle = nextLesson?.title ?? null;
}

const lessonsDone = enrollments.reduce((sum, enrollment) => sum + (enrollment.current_lesson || 0), 0);
const colors = ['#2563eb', '#f59e0b', '#10b981', '#8b5cf6'];
const confettiColors = ['#2563eb', '#f59e0b', '#10b981', '#ec4899', '#8b5cf6'];
const pct = (enrollment: Row) => enrollment.lesson_count
  ? Math.min(100, Math.round((enrollment.current_lesson / enrollment.lesson_count) * 100))
  : 0;
const fmtDate = (date: string) => new Date(date).toLocaleDateString('cs-CZ');
---

<PublicLayout title="Můj profil">
  <div class="wrap prof">
    <div class="phead">
      <div class="pav">{(user.name || user.email || '?').charAt(0).toUpperCase()}</div>
      <div>
        <h1 class="hi">Ahoj, {user.name || 'studente'}! 👋</h1>
        <p class="hisub">Máš za sebou {lessonsDone} lekcí. Jen tak dál.</p>
      </div>
    </div>

    <div class="pstats">
      <div class="pstat">
        <div class="ic">📚</div>
        <div><div class="num">{active.length}</div><div class="lbl">rozpracované kurzy</div></div>
      </div>
      <div class="pstat">
        <div class="ic">✅</div>
        <div><div class="num">{lessonsDone}</div><div class="lbl">dokončených lekcí</div></div>
      </div>
      <div class="pstat">
        <div class="ic">🏅</div>
        <div><div class="num">{certificates.length}</div><div class="lbl">{certificates.length === 1 ? 'získaný certifikát' : 'získané certifikáty'}</div></div>
      </div>
    </div>

    <div class="sr-actions">
      <a class="btn btn-white btn-sm" href="/profil/nastaveni">Nastavení</a>
      <form method="POST" action="/api/auth/logout">
        <button type="submit" class="btn btn-white btn-sm">Odhlásit se</button>
      </form>
    </div>

    {featured && (
      <Fragment>
        <div class="psec">Pokračuj v učení</div>
        <div class="pfeature">
          <div class="glow"></div>
          <div class="ft-top">
            <div style="flex:1">
              <span class="ft-tag">Lekce {featured.current_lesson + 1} z {featured.lesson_count}</span>
              <h3>{featured.title}</h3>
              {nextLessonTitle && <div class="nl">Další: {nextLessonTitle}</div>}
            </div>
          </div>
          <div class="pbarwrap"><div class="pbar" style={`width:${pct(featured)}%`}></div></div>
          <div class="pmeta"><span>{featured.current_lesson} z {featured.lesson_count} hotovo</span><span>{pct(featured)} %</span></div>
          <div class="ftcta">
            <a class="btn btn-purple btn-sm" href={`/profil/kurz/${featured.id}`}>Pokračovat →</a>
            <span class="when">📬 Další lekce dorazí podle nastaveného tempa</span>
          </div>
        </div>
      </Fragment>
    )}

    <div class="psec">Moje kurzy</div>
    {enrollments.length === 0 ? (
      <p style="color:#3a323e;font-weight:600">
        Zatím nejste zapsaní v žádném kurzu. <a href="/" style="color:#7c3aed;font-weight:800">Vyberte si první →</a>
      </p>
    ) : (
      <div class="plist">
        {enrollments.map((enrollment, index) => (
          <a class="prow" href={`/profil/kurz/${enrollment.id}`}>
            <div class="pdot" style={`background:${colors[index % 4]}`}>{pct(enrollment)}%</div>
            <div class="pinfo">
              <h4>{enrollment.title}</h4>
              <div class="mini"><i style={`width:${pct(enrollment)}%;background:${colors[index % 4]}`}></i></div>
            </div>
            {enrollment.status === 'completed'
              ? <span class="done">Dokončeno</span>
              : <span class="pct">{enrollment.current_lesson}/{enrollment.lesson_count} lekcí</span>}
          </a>
        ))}
      </div>
    )}

    {certificates.length > 0 && (
      <Fragment>
        <div class="psec">{certificates.length === 1 ? 'Tvůj certifikát' : 'Tvé certifikáty'}</div>
        {certificates.map((cert) => (
          <div class="cert" style="margin-bottom:12px">
            {Array.from({ length: 10 }).map((_, index) => (
              <span class="conf" style={`left:${8 + index * 9}%;background:${confettiColors[index % 5]};animation-delay:${index * 0.22}s`}></span>
            ))}
            <div class="seal">
              <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M12 2l2.4 4.9 5.4.8-3.9 3.8.9 5.4-4.8-2.5-4.8 2.5.9-5.4L4.2 7.7l5.4-.8L12 2z" fill="#fff" />
              </svg>
            </div>
            <div class="ci">
              <div class="ck">Certifikát o absolvování</div>
              <h3>{cert.title}</h3>
              <p>{cert.score != null ? `Skóre ${cert.score} % · ` : ''}vydáno {fmtDate(cert.issued_at)}</p>
            </div>
            <a class="btn btn-orange btn-big" href={`/api/certificates/${cert.public_id}`}>Stáhnout PDF</a>
          </div>
        ))}
      </Fragment>
    )}
  </div>
</PublicLayout>
