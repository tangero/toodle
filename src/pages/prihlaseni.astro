---
import SiteLayout from '@layouts/SiteLayout.astro';

const error = Astro.url.searchParams.get('error');
const redirectTo = Astro.url.searchParams.get('redirect') || '/profil';

const errorMessages: Record<string, string> = {
  'missing-token': 'Přihlašovací odkaz je neúplný. Nechte si poslat nový.',
  'invalid-token': 'Přihlašovací odkaz vypršel nebo už byl použit. Nechte si poslat nový.',
};
---

<SiteLayout title="Přihlášení" description="Přihlášení do Školy AI odkazem zaslaným na e-mail, bez hesla.">
  <div class="wrap">
    <a class="back" href="/">← Zpět na hlavní stránku</a>

    <header class="page-head">
      <h1>Přihlášení</h1>
      <p class="lead">Zadejte e-mail, se kterým jste se zapsali do kurzu. Pošleme vám přihlašovací odkaz, heslo nepotřebujete.</p>
    </header>

    <div class="page-body narrow">
      {error && (
        <p class="note err">{errorMessages[error] || 'Přihlášení se nepodařilo. Nechte si poslat nový odkaz.'}</p>
      )}

      <form id="login-form" class="form" method="post">
        <input type="hidden" name="redirect" value={redirectTo} />
        <div class="field">
          <label for="email">E-mail</label>
          <input
            type="email"
            id="email"
            name="email"
            required
            maxlength="254"
            autocomplete="email"
            inputmode="email"
            spellcheck="false"
            enterkeyhint="send"
            data-error="email-error"
          />
          <span class="error-msg" id="email-error">E-mail není ve správném tvaru. Zadejte ho jako jmeno@example.cz.</span>
        </div>
        <button type="submit" class="btn btn-accent" data-label="Poslat přihlašovací odkaz">Poslat přihlašovací odkaz</button>
      </form>

      <div aria-live="polite">
        <p id="message" class="note" tabindex="-1" hidden></p>
      </div>
    </div>
  </div>

  <script>
    import { initFormErrors } from '../scripts/form-errors';

    const form = document.getElementById('login-form') as HTMLFormElement;
    const messageEl = document.getElementById('message') as HTMLParagraphElement;
    initFormErrors(form);

    const showMessage = (text: string, ok: boolean) => {
      messageEl.textContent = text;
      messageEl.classList.toggle('ok', ok);
      messageEl.classList.toggle('err', !ok);
      messageEl.hidden = false;
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const formData = new FormData(form);
      const email = formData.get('email') as string;
      const next = formData.get('redirect') as string;
      const button = form.querySelector('button') as HTMLButtonElement;
      const label = button.dataset.label ?? '';

      button.disabled = true;
      button.textContent = 'Odesílám…';
      messageEl.hidden = true;
      messageEl.textContent = '';

      try {
        const res = await fetch('/api/auth/magic-link', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email, next }),
        });
        const data = (await res.json()) as { message?: string; error?: string };

        if (res.ok) {
          form.hidden = true;
          showMessage(data.message || 'Podívejte se do své e-mailové schránky.', true);
          // Formulář zmizel, focus přesuneme na hlášku.
          messageEl.focus();
        } else {
          showMessage(data.error || 'Odkaz se nepodařilo odeslat. Zkuste to za chvíli znovu.', false);
        }
      } catch {
        showMessage('Odkaz se nepodařilo odeslat. Zkontrolujte připojení k internetu a zkuste to znovu.', false);
      } finally {
        button.disabled = false;
        button.textContent = label;
      }
    });
  </script>
</SiteLayout>
