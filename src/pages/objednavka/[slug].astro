---
import SiteLayout from '@layouts/SiteLayout.astro';
import { getOne } from '@lib/db';
import type { Course, Enrollment } from '@lib/types';
import { env } from '@lib/env';
import { deliveryLabel, lessonCountLabel, priceLabel } from '@lib/labels';
import { getUserMunicipality } from '@lib/municipalities';
import MunicipalityField from '@components/MunicipalityField.astro';

const { slug } = Astro.params;

const user = Astro.locals.user;

const course = await getOne<Course>(
  env.DB,
  `SELECT * FROM courses WHERE slug = ? AND status = 'published'`,
  slug,
);
if (!course) return Astro.redirect('/');

// Přihlášený uživatel, který už kurz má, nedostane formulář, ale odkaz na svůj kurz.
let existingEnrollment: Enrollment | null = null;
if (user) {
  existingEnrollment = await getOne<Enrollment>(
    env.DB,
    `SELECT * FROM enrollments WHERE user_id = ? AND course_id = ? AND status != 'cancelled'`,
    user.id,
    course.id,
  );
}

const free = course.price_czk === 0;

// Čekající zápis do bezplatného kurzu (potvrzovací odkaz propadl nebo se ztratil): přihlášený
// uživatel dostane formulář znovu a odesláním kurz spustí, API ho aktivuje bez dalšího e-mailu.
const resumesPending = !!existingEnrollment && existingEnrollment.status === 'pending' && free;
if (resumesPending) existingEnrollment = null;
// Přihlášený bez vyplněné obce dostane pole obce, kdo ji má, ten ho neuvidí (změní ji v nastavení).
const userMunicipality = user ? await getUserMunicipality(env.DB, user.id) : null;
const askMunicipality = !userMunicipality;
const submitLabel = free ? 'Zapsat se zdarma' : `Objednat za ${priceLabel(course.price_czk)}`;
---

<SiteLayout
  title={`${free ? 'Zápis do kurzu' : 'Objednávka kurzu'} ${course.title}`}
  description={course.perex}
>
  <div class="wrap">
    <a class="back" href={`/kurz/${course.slug}`}>← Zpět na kurz</a>

    <header class="page-head">
      <p class="mono">{free ? 'Zápis do kurzu' : 'Objednávka kurzu'}</p>
      <h1>{course.title}</h1>
      <p class="lead">{course.perex}</p>
      <p class="mono">
        {lessonCountLabel(course.lesson_count)} · {deliveryLabel(course.delivery_mode)} · {priceLabel(course.price_czk)}
      </p>
    </header>

    <div class="page-body narrow">
      {existingEnrollment ? (
        <div class="note">
          <p><strong>V tomto kurzu už jste zapsáni.</strong></p>
          <p>Průběh kurzu a jeho lekce najdete ve svém profilu.</p>
          <p class="actions">
            <a class="btn" href={`/profil/kurz/${existingEnrollment.id}`}>Přejít na kurz</a>
          </p>
        </div>
      ) : (
        <div class="stack">
          {resumesPending && (
            <p class="note">Zápis do tohoto kurzu jste ještě nepotvrdili. Tlačítkem níže ho potvrdíte a kurz se spustí.</p>
          )}
          <form id="order-form" class="form" method="post">
            <input type="hidden" id="course-slug" name="slug" value={course.slug} />
            <input type="hidden" id="course-id" name="course_id" value={course.id} />

            {!user && (
              <>
                <div class="field">
                  <label for="name">Jméno a příjmení</label>
                  <span class="hint" id="name-hint">Uvedeme ho na certifikátu.</span>
                  <input
                    type="text"
                    id="name"
                    name="name"
                    required
                    maxlength="80"
                    autocomplete="name"
                    enterkeyhint="next"
                    aria-describedby="name-hint"
                    data-error="name-error"
                  />
                  <span class="error-msg" id="name-error">Chybí jméno. Vyplňte své jméno a příjmení.</span>
                </div>
                <div class="field">
                  <label for="email">E-mail</label>
                  <span class="hint" id="email-hint">Na tuto adresu vám budou chodit lekce.</span>
                  <input
                    type="email"
                    id="email"
                    name="email"
                    required
                    maxlength="254"
                    autocomplete="email"
                    inputmode="email"
                    spellcheck="false"
                    enterkeyhint="next"
                    aria-describedby="email-hint"
                    data-error="email-error"
                  />
                  <span class="error-msg" id="email-error">E-mail není ve správném tvaru. Zadejte ho jako jmeno@example.cz.</span>
                </div>
              </>
            )}

            {user && (
              <div class="note"><p>Zapisujete se jako <strong>{user.email}</strong>.</p></div>
            )}

            {askMunicipality && <MunicipalityField />}

            <p class="hint">
              Součástí lekcí je krátká nabídka našeho dalšího vzdělávání. Odhlásit se můžete jedním kliknutím.
              <a href="/ochrana-osobnich-udaju">Zásady zpracování osobních údajů</a>
            </p>

            <div aria-live="polite">
              <p id="error-msg" class="note err" hidden></p>
            </div>

            <button type="submit" class="btn btn-accent" data-label={submitLabel}>{submitLabel}</button>
          </form>

          <div id="order-result" hidden>
            <div id="result-free" class="note ok" hidden>
              <h2 id="result-free-title" tabindex="-1">Zbývá potvrdit e-mail</h2>
              <p>
                Na váš e-mail jsme poslali odkaz pro potvrzení zápisu. Platí 48 hodin. Po jeho potvrzení
                vám začnou chodit lekce.
              </p>
              <p class="hint">
                E-mail nepřišel? Podívejte se do složky s nevyžádanou poštou. Když ho nenajdete, zapište
                se znovu a odkaz pošleme ještě jednou.
              </p>
            </div>

            <div id="result-paid" class="stack" hidden>
              <div class="note">
                <h2 id="result-paid-title" tabindex="-1">Pokyny k platbě</h2>
                <p>Kurz uhraďte bankovním převodem. Po přijetí platby vám pošleme první lekci.</p>
              </div>
              <dl class="facts one">
                <div><dt>Číslo účtu</dt><dd>2702819819/2010</dd></div>
                <div><dt>Variabilní symbol</dt><dd id="pay-vs"></dd></div>
                <div><dt>Částka</dt><dd id="pay-amount"></dd></div>
              </dl>
              <p class="hint">Platba je splatná do 14 dní.</p>
            </div>
          </div>
        </div>
      )}
    </div>
  </div>

  <script>
    import { initFormErrors } from '../../scripts/form-errors';

    const form = document.getElementById('order-form') as HTMLFormElement | null;
    const resultEl = document.getElementById('order-result') as HTMLDivElement | null;
    const errorEl = document.getElementById('error-msg') as HTMLParagraphElement | null;

    if (form && resultEl && errorEl) {
      initFormErrors(form);

      const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
      const label = btn.dataset.label ?? btn.textContent ?? '';

      const showError = (text: string) => {
        errorEl.textContent = text;
        errorEl.hidden = false;
        btn.disabled = false;
        btn.textContent = label;
      };

      const showResult = (blockId: string, titleId: string) => {
        form.hidden = true;
        resultEl.hidden = false;
        (document.getElementById(blockId) as HTMLElement).hidden = false;
        // Formulář zmizel, focus proto přesuneme na nadpis výsledku, ať ho čtečka přečte.
        (document.getElementById(titleId) as HTMLElement).focus();
      };

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        btn.disabled = true;
        btn.textContent = 'Zapisuji…';
        errorEl.hidden = true;
        errorEl.textContent = '';

        const slug = (document.getElementById('course-slug') as HTMLInputElement).value;
        const emailEl = document.getElementById('email') as HTMLInputElement | null;
        const nameEl = document.getElementById('name') as HTMLInputElement | null;

        const body: Record<string, string> = { slug };
        if (emailEl) body.email = emailEl.value;
        if (nameEl) body.name = nameEl.value;
        const municipalityEl = form.querySelector<HTMLInputElement>('[name="municipality_code"]');
        if (municipalityEl?.value) body.municipality_code = municipalityEl.value;

        try {
          const res = await fetch('/api/orders/create', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(body),
          });
          const data = await res.json() as {
            ok?: boolean; error?: string; type?: string;
            vs?: string; amount?: number; free?: boolean; status?: string; resent?: boolean; enrollmentId?: string;
          };

          if (!res.ok) {
            showError(data.error ?? 'Zápis se nepodařilo uložit. Zkuste formulář odeslat znovu.');
            return;
          }

          if (data.free && data.status === 'active') {
            // Přihlášený uživatel: kurz běží hned.
            window.location.href = `/profil/kurz/${data.enrollmentId}`;
            return;
          }

          if (data.free) {
            if (data.resent) {
              (document.getElementById('result-free-title') as HTMLElement).textContent = 'Odkaz jsme poslali znovu';
            }
            showResult('result-free', 'result-free-title');
          } else {
            (document.getElementById('pay-vs') as HTMLElement).textContent = String(data.vs ?? '');
            (document.getElementById('pay-amount') as HTMLElement).textContent = `${data.amount} Kč`;
            showResult('result-paid', 'result-paid-title');
          }
        } catch {
          showError('Zápis se nepodařilo odeslat. Zkontrolujte připojení k internetu a zkuste to znovu.');
        }
      });
    }
  </script>
</SiteLayout>
