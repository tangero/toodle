---
import SiteLayout from '@layouts/SiteLayout.astro';
---

<SiteLayout title="Stránka nenalezena">
  <div class="wrap">
    <header class="page-head">
      <p class="mono">Chyba 404</p>
      <h1>Stránku jsme nenašli</h1>
      <p class="lead">Adresa neexistuje, nebo jsme stránku přesunuli. Zkuste to z hlavní stránky.</p>
    </header>
    <div class="page-body">
      <p class="actions">
        <a class="btn" href="/">Zpět na hlavní stránku</a>
        <a class="btn btn-line" href="/#kurzy">Přehled kurzů</a>
      </p>
    </div>
  </div>
</SiteLayout>
