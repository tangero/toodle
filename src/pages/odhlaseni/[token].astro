---
import SiteLayout from '@layouts/SiteLayout.astro';
import { verifyUnsubscribeToken } from '@lib/unsubscribe';
import { cancelEnrollmentByToken, type UnsubscribeResult } from '@lib/unsubscribe-action';
import { getOne } from '@lib/db';
import { env } from '@lib/env';

const { token = '' } = Astro.params;

// GET jen zobrazí potvrzení – odkaz v e-mailu otevírají i bezpečnostní skenery pošty,
// které by jinak studenty potichu odhlásily. Odhlášení provede až POST z tlačítka.
let status: UnsubscribeResult | 'confirm' = 'invalid';
let courseTitle = '';

if (Astro.request.method === 'POST') {
  status = await cancelEnrollmentByToken(token);
} else {
  const enrollmentId = await verifyUnsubscribeToken(token, env.JWT_SECRET);
  if (enrollmentId) {
    const row = await getOne<{ status: string; title: string }>(
      env.DB,
      `SELECT e.status, c.title FROM enrollments e JOIN courses c ON c.id = e.course_id WHERE e.id = ?`,
      enrollmentId,
    );
    if (row) {
      courseTitle = row.title;
      status = row.status === 'cancelled' ? 'already' : row.status === 'completed' ? 'completed' : 'confirm';
    }
  }
}
---

<SiteLayout title="Odhlášení z kurzu">
  <div class="wrap">
    {status === 'confirm' && (
      <>
        <header class="page-head">
          <h1>Odhlásit se z kurzu?</h1>
          <p class="lead">Kurz <strong>{courseTitle}</strong>: další lekce vám přestanou chodit.</p>
        </header>
        <div class="page-body narrow">
          <form method="post" class="actions">
            <button type="submit" class="btn">Ano, odhlásit z kurzu</button>
            <a class="btn btn-line" href="/profil">Ne, chci pokračovat</a>
          </form>
        </div>
      </>
    )}
    {status === 'ok' && (
      <>
        <header class="page-head">
          <h1>Z kurzu jste odhlášeni</h1>
          <p class="lead">Další lekce vám už nebudou chodit. Zapsat se můžete kdykoli znovu.</p>
        </header>
        <div class="page-body narrow">
          <p class="actions"><a class="btn" href="/">Zpět na hlavní stránku</a></p>
        </div>
      </>
    )}
    {status === 'already' && (
      <>
        <header class="page-head">
          <h1>Z kurzu už jste odhlášeni</h1>
          <p class="lead">Odhlášení proběhlo dříve, žádné další lekce vám nechodí. Zapsat se můžete kdykoli znovu.</p>
        </header>
        <div class="page-body narrow">
          <p class="actions"><a class="btn" href="/">Zpět na hlavní stránku</a></p>
        </div>
      </>
    )}
    {status === 'completed' && (
      <>
        <header class="page-head">
          <h1>Kurz máte dokončený</h1>
          <p class="lead">Všechny lekce už vám přišly, žádné další e-maily z kurzu nedostanete.</p>
        </header>
        <div class="page-body narrow">
          <p class="actions"><a class="btn" href="/">Zpět na hlavní stránku</a></p>
        </div>
      </>
    )}
    {status === 'invalid' && (
      <>
        <header class="page-head">
          <h1>Odkaz není platný</h1>
          <p class="lead">
            Odkaz pro odhlášení je neúplný nebo poškozený. Otevřete ho znovu přímo z e-mailu s lekcí,
            nebo kurz pozastavte ve svém profilu.
          </p>
        </header>
        <div class="page-body narrow">
          <p class="actions"><a class="btn" href="/profil">Přejít do profilu</a></p>
        </div>
      </>
    )}
  </div>
</SiteLayout>
