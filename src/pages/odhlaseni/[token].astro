---
import PublicLayout from '@layouts/PublicLayout.astro';
import { verifyUnsubscribeToken } from '@lib/unsubscribe';
import { cancelEnrollmentByToken, type UnsubscribeResult } from '@lib/unsubscribe-action';
import { getOne } from '@lib/db';
import { env } from '@lib/env';

const { token = '' } = Astro.params;

// GET jen zobrazí potvrzení – odkaz v e-mailu otevírají i bezpečnostní skenery pošty,
// které by jinak studenty potichu odhlásily. Odhlášení provede až POST z tlačítka.
let status: UnsubscribeResult | 'confirm' = 'invalid';
let courseTitle = '';

if (Astro.request.method === 'POST') {
  status = await cancelEnrollmentByToken(token);
} else {
  const enrollmentId = await verifyUnsubscribeToken(token, env.JWT_SECRET);
  if (enrollmentId) {
    const row = await getOne<{ status: string; title: string }>(
      env.DB,
      `SELECT e.status, c.title FROM enrollments e JOIN courses c ON c.id = e.course_id WHERE e.id = ?`,
      enrollmentId,
    );
    if (row) {
      courseTitle = row.title;
      status = row.status === 'cancelled' ? 'already' : row.status === 'completed' ? 'completed' : 'confirm';
    }
  }
}
---

<PublicLayout title="Odhlášení z kurzu">
  <div class="mx-auto max-w-md py-16 text-center">
    {status === 'confirm' && (
      <div>
        <h1 class="text-2xl font-bold text-gray-900">Odhlásit se z kurzu?</h1>
        <p class="mt-2 text-gray-600">Kurz <strong>{courseTitle}</strong> – další lekce vám přestanou chodit.</p>
        <form method="post" class="mt-6">
          <button type="submit" class="rounded-lg bg-gray-800 px-6 py-2 text-sm font-medium text-white hover:bg-gray-900">
            Ano, odhlásit z kurzu
          </button>
        </form>
        <a href="/profil" class="mt-4 inline-block text-sm text-gray-500 hover:text-gray-700">Ne, chci pokračovat</a>
      </div>
    )}
    {status === 'ok' && (
      <div>
        <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-gray-100">
          <svg class="h-8 w-8 text-gray-500" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
          </svg>
        </div>
        <h1 class="mt-4 text-2xl font-bold text-gray-900">Odhlášení proběhlo</h1>
        <p class="mt-2 text-gray-600">Byli jste odhlášeni z kurzu. Další lekce vám nebudou chodit. Zapsat se můžete kdykoli znovu.</p>
        <a href="/" class="mt-6 inline-block rounded-lg bg-gray-800 px-6 py-2 text-sm font-medium text-white hover:bg-gray-900">
          Zpět na hlavní stránku
        </a>
      </div>
    )}
    {status === 'already' && (
      <div>
        <h1 class="text-2xl font-bold text-gray-900">Již odhlášeno</h1>
        <p class="mt-2 text-gray-600">Z tohoto kurzu jste již dříve odhlášeni.</p>
      </div>
    )}
    {status === 'completed' && (
      <div>
        <h1 class="text-2xl font-bold text-gray-900">Kurz je dokončený</h1>
        <p class="mt-2 text-gray-600">Všechny lekce už vám přišly, žádné další e-maily z kurzu nedostanete.</p>
      </div>
    )}
    {status === 'invalid' && (
      <div>
        <h1 class="text-2xl font-bold text-gray-900">Neplatný odkaz</h1>
        <p class="mt-2 text-gray-600">Odkaz pro odhlášení je neplatný.</p>
      </div>
    )}
  </div>
</PublicLayout>
